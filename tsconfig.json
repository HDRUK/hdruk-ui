{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "src/**/*",
    ".storybook/**/*",
    "test/**/*",
    "jest.setup.ts",
    "*.config.ts",
    "*.config.mjs"
  ],
  "exclude": ["dist", "node_modules"]
}
